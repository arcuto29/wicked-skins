{
  "name": "priism-skins-desktop",
  "productName": "Priism Skins",
  "version": "0.1.25",
  "description": "Priism Skins desktop app: TradingView with live wallpapers (Windows, macOS, Linux)",
  "author": "arcuto29",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:publish": "electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.priism.skins",
    "productName": "Priism Skins",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "tv-preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../src",
        "to": "shared/src"
      },
      {
        "from": "../popup",
        "to": "shared/popup"
      },
      {
        "from": "../icons",
        "to": "shared/icons"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "../icons/icon-512.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.finance",
      "icon": "../icons/icon-1024.png",
      "identity": null
    },
    "linux": {
      "target": "AppImage",
      "icon": "../icons/icon-512.png",
      "category": "Finance"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "arcuto29",
        "repo": "wicked-skins",
        "releaseType": "release"
      }
    ]
  }
}
